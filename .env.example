# The explorer never exposes these credentials to the browser.
RAVEN_RPC_URL=http://127.0.0.1:8766
RAVEN_RPC_USER=ravencoinrpc
RAVEN_RPC_PASSWORD=replace-me
RAVEN_RPC_TIMEOUT_MS=4000

# PostgreSQL-backed explorer mode. Omit DATABASE_URL to retain the lightweight
# direct-RPC mode used by the frontend preview.
DATABASE_URL=postgresql://ravencoin:replace-me@127.0.0.1:5432/ravencoin_explorer
DATABASE_POOL_SIZE=12
DATABASE_STATEMENT_TIMEOUT_MS=10000
EXPLORER_DATA_SOURCE=postgres
API_RATE_LIMIT_PER_MINUTE=180
TRUST_PROXY=false

# Indexer tuning. Larger batches backfill faster but use more node/DB memory.
INDEXER_BATCH_SIZE=20
INDEXER_FETCH_CONCURRENCY=1
INDEXER_RAW_LEAD_BLOCKS=1000
INDEXER_POLL_MS=5000
INDEXER_ASSET_PAGE_SIZE=1000
INDEXER_BOOTSTRAP_ASSETS=true

# auto: use RPC when reachable, otherwise clearly-labeled demo data
# false: require a live RPC connection
# true: always use demo data
EXPLORER_DEMO_MODE=auto
PORT=3000
