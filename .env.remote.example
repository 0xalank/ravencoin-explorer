POSTGRES_USER=ravencoin
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=ravencoin_explorer
POSTGRES_DATA_DIR=/home/quai/ravencoin-explorer/postgres-data
RAVEN_RPC_USER=ravencoinrpc
RAVEN_RPC_PASSWORD=replace-with-a-different-long-random-secret
RAVEN_DATA_DIR=/home/quai/ravencoin-explorer/ravencoin-data
RAVEN_P2P_PORT=8767
EXPLORER_PORT=3102
RAVEN_IMAGE_TAG=1ecb659
EXPLORER_IMAGE_TAG=latest
INDEXER_BATCH_SIZE=500
INDEXER_FETCH_CONCURRENCY=8
INDEXER_RAW_LEAD_BLOCKS=5000
INDEXER_WORK_MEM=512MB
INDEXER_STALE_SECONDS=600
TRUST_PROXY=false

# Cron-friendly operational thresholds. Optimized catch-up stays well below
# 1 GiB of PostgreSQL temp I/O per five-minute interval.
MONITOR_HEALTH_URL=http://127.0.0.1:3000/api/health
MONITOR_DISK_PATH=/
MONITOR_MIN_DISK_FREE_BYTES=107374182400
MONITOR_MIN_DISK_FREE_PERCENT=10
MONITOR_MAX_TEMP_BYTES_PER_INTERVAL=1073741824
MONITOR_STATE_FILE=/app/ops-state/monitor.json
RECONCILE_BLOCK_SAMPLES=8
RECONCILE_BALANCE_SAMPLES=6
RECONCILE_TRANSFER_SAMPLES=16
RECONCILE_RPC_BATCH_SIZE=4
RECONCILE_RPC_TIMEOUT_MS=120000
RECONCILE_DATABASE_TIMEOUT_MS=120000
RECONCILE_REQUIRE_ASSET_SAMPLES=true
RECONCILE_ASSET_GRACE_BLOCKS=1440
