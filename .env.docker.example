POSTGRES_USER=ravencoin
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=ravencoin_explorer
EXPLORER_PORT=3000

# A ravend instance reachable from the Docker host.
RAVEN_RPC_URL=http://host.docker.internal:8766
RAVEN_RPC_USER=ravencoinrpc
RAVEN_RPC_PASSWORD=replace-with-the-ravend-rpc-secret

EXPLORER_DEMO_MODE=false
API_RATE_LIMIT_PER_MINUTE=180
INDEXER_BATCH_SIZE=20
INDEXER_FETCH_CONCURRENCY=1
INDEXER_RAW_LEAD_BLOCKS=1000
INDEXER_WORK_MEM=512MB
INDEXER_JSON_CHUNK_BYTES=67108864
INDEXER_STALE_SECONDS=600
INDEXER_POLL_MS=5000
INDEXER_BOOTSTRAP_ASSETS=true
