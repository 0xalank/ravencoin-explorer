{
  "name": "dominant-ravencoin-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "indexer": "node server/indexer.mjs",
    "db:migrate": "node server/migrate.mjs",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f explorer indexer",
    "ops:reconcile": "node scripts/ops/reconcile-rpc.mjs",
    "ops:monitor": "node scripts/ops/monitor.mjs",
    "ops:snapshot": "bash scripts/ops/postgres-snapshot.sh",
    "ops:snapshot:verify": "bash scripts/ops/verify-postgres-snapshot.sh",
    "ops:snapshot:restore": "bash scripts/ops/restore-postgres-snapshot.sh",
    "ops:txindex:init": "bash scripts/ops/txindex-init.sh",
    "ops:txindex:seed": "bash scripts/ops/txindex-seed.sh",
    "ops:txindex:start-reindex": "bash scripts/ops/txindex-start-reindex.sh",
    "ops:txindex:status": "bash scripts/ops/txindex-status.sh",
    "ops:txindex:finalize": "bash scripts/ops/txindex-finalize.sh",
    "ops:txindex:snapshot": "bash scripts/ops/txindex-snapshot.sh",
    "ops:txindex:publish-when-ready": "bash scripts/ops/txindex-publish-when-ready.sh",
    "ops:txindex:verify": "bash scripts/ops/verify-txindex-snapshot.sh",
    "ops:check": "node --check scripts/ops/reconcile-rpc.mjs && node --check scripts/ops/monitor.mjs && node --check scripts/ops/redact-database-url.mjs && bash -n scripts/ops/postgres-snapshot.sh scripts/ops/verify-postgres-snapshot.sh scripts/ops/restore-postgres-snapshot.sh scripts/ops/txindex-init.sh scripts/ops/txindex-seed.sh scripts/ops/txindex-start-reindex.sh scripts/ops/txindex-status.sh scripts/ops/txindex-finalize.sh scripts/ops/txindex-snapshot.sh scripts/ops/txindex-publish-when-ready.sh scripts/ops/verify-txindex-snapshot.sh",
    "test": "node --test server/*.test.mjs",
    "check": "pnpm test && pnpm build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "^17.4.2",
    "express": "latest",
    "lucide-react": "latest",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2"
}
